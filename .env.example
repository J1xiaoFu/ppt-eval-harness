PPT_EVAL_BROKER_URL=redis://127.0.0.1:6379/0
PPT_EVAL_RESULT_BACKEND=redis://127.0.0.1:6379/1
PPT_EVAL_DATABASE_URL=postgresql://ppt_eval:ppt_eval@127.0.0.1:5432/ppt_eval
PPT_EVAL_S3_ENDPOINT=http://127.0.0.1:9000
PPT_EVAL_S3_BUCKET=ppt-eval
PPT_EVAL_S3_ACCESS_KEY=ppt-eval
PPT_EVAL_S3_SECRET_KEY=change-me

# Model audit providers. Keep real keys in the environment or an ignored local file.
PPT_EVAL_QWEN_AUDIT_ENABLED=true
DASHSCOPE_API_KEY=
PPT_EVAL_DASHSCOPE_API_KEY_FILE=api/qwen3.7_flash_api.txt
PPT_EVAL_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
PPT_EVAL_QWEN_FLASH_MODEL=qwen3.7-flash
PPT_EVAL_QWEN_PLUS_MODEL=qwen3.7-plus

# Empty by default: model audits may use inline source text but cannot read local files.
# Set one or more approved source directories, separated by the platform path separator
# (semicolon on Windows, colon on Linux/macOS).
PPT_EVAL_MODEL_SOURCE_ROOTS=
# Qwen HTTP transport timeout only; Profile oracle_timeout_seconds is not yet enforced.
PPT_EVAL_QWEN_HTTP_TIMEOUT_SECONDS=120
# Plus VLM needed more than 120s on a real 17-page deck; keep a separate ceiling.
PPT_EVAL_QWEN_PLUS_HTTP_TIMEOUT_SECONDS=240
