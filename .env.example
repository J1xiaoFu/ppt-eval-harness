# Model audit providers. Keep real keys in the environment or an ignored local file.
PPT_EVAL_QWEN_AUDIT_ENABLED=false
DASHSCOPE_API_KEY=
PPT_EVAL_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
PPT_EVAL_QWEN_FLASH_MODEL=qwen3.8-flash

# Criterion-isomorphic fallback. Official model code includes both hyphens.
PPT_EVAL_ZHIPU_AUDIT_ENABLED=false
ZAI_API_KEY=
PPT_EVAL_ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
PPT_EVAL_ZHIPU_MODEL=glm-5.3-flash

# Model audits receive rendered slide pixels and bounded case text only; they never
# open or upload paths listed in source_materials.
# Persist full-page renders for the server-side human audit workspace even when
# a model criterion does not need them. Docker enables this by default.
PPT_EVAL_REVIEW_RENDERING_ENABLED=true
# Provider HTTP transport timeouts; Profile oracle_timeout_seconds is not yet enforced.
PPT_EVAL_QWEN_HTTP_TIMEOUT_SECONDS=120
PPT_EVAL_ZHIPU_HTTP_TIMEOUT_SECONDS=300
