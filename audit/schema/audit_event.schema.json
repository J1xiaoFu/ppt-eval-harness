{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/ppt-eval/runtime-audit-event.schema.json",
  "title": "PPT Eval append-only runtime audit event",
  "description": "Current Profile 8.4 hash-chained runtime event using schema 1.0. Profile 8.3 remains an explicit replay contract; older schemas are preserved by archive/v8.3-pre-release.",
  "type": "object",
  "required": [
    "event_id",
    "run_id",
    "event_type",
    "occurred_at",
    "actor",
    "payload",
    "previous_hash",
    "event_hash",
    "supersedes",
    "schema_version"
  ],
  "properties": {
    "event_id": {"$ref": "#/$defs/recordId"},
    "run_id": {"$ref": "#/$defs/recordId"},
    "event_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "occurred_at": {"type": "string", "format": "date-time"},
    "actor": {"type": "string", "minLength": 1, "maxLength": 128},
    "payload": {"type": "object"},
    "previous_hash": {"$ref": "#/$defs/nullableSha256"},
    "event_hash": {"$ref": "#/$defs/sha256"},
    "supersedes": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/recordId"}
      ]
    },
    "schema_version": {"const": "1.0"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"event_type": {"const": "HUMAN_REVIEW_RECORDED"}},
        "required": ["event_type"]
      },
      "then": {
        "properties": {"payload": {"$ref": "#/$defs/reviewPayload"}}
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "recordId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableSha256": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/sha256"}
      ]
    },
    "reviewPayload": {
      "type": "object",
      "required": [
        "run_id",
        "reviewer_id",
        "verdict",
        "issue_resolutions",
        "track_resolutions",
        "machine_decision",
        "machine_coverage",
        "triage_policy_version",
        "review_id",
        "created_at",
        "idempotency_fingerprint"
      ],
      "properties": {
        "run_id": {"$ref": "#/$defs/recordId"},
        "reviewer_id": {"type": "string", "minLength": 1},
        "verdict": {
          "enum": [
            "CONFIRM_SYSTEM_DECISION",
            "OVERRIDE_DECISION",
            "REQUEST_MORE_EVIDENCE"
          ]
        },
        "target_decision": {
          "oneOf": [
            {"type": "null"},
            {"enum": ["PASS", "REVIEW", "FAIL", "ERROR"]}
          ]
        },
        "note": {"type": "string"},
        "client_request_id": {"type": ["string", "null"], "maxLength": 128},
        "issue_resolutions": {"type": "array"},
        "track_resolutions": {"type": "object"},
        "machine_decision": {"enum": ["PASS", "REVIEW", "FAIL", "ERROR"]},
        "machine_coverage": {
          "enum": ["FULL", "DEGRADED", "BASE_ONLY", "UNASSESSABLE"]
        },
        "report_hash": {"type": ["string", "null"]},
        "observation_hash": {"type": ["string", "null"]},
        "triage_policy_version": {"type": "string", "minLength": 1},
        "review_id": {"$ref": "#/$defs/recordId"},
        "created_at": {"type": "string", "format": "date-time"},
        "idempotency_fingerprint": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  }
}
